# ==============================================================================
# PRO FOOTBALL LIVE STUDIO — VERSION 2 ENVIRONMENT VARIABLES
# ==============================================================================

# Server Network & Environment
NODE_ENV=production
PORT=5000
CLIENT_URL=https://pro-football-live-studio.onrender.com
CORS_ORIGIN=*

# JWT Security
JWT_SECRET=super_secure_random_jwt_secret_change_me_in_production_min_32_chars
JWT_EXPIRES_IN=24h

# Database Adapter Selection ('sheets' or 'memory' or 'file')
DB_ADAPTER=file

# Google Sheets API Configuration (Required if DB_ADAPTER=sheets)
# Obtain these from Google Cloud Console > Service Accounts
GOOGLE_SHEET_ID=1_Your_Google_Spreadsheet_ID_Here
GOOGLE_SERVICE_ACCOUNT_EMAIL=football-studio-sa@your-gcp-project.iam.gserviceaccount.com
# Use \n for newlines in private key string
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQD...\n-----END PRIVATE KEY-----\n"

# Facebook Live Broadcast Settings (Production / Operator default)
# RTMPS URL provided by Meta Facebook Live Producer
FACEBOOK_RTMPS_URL=rtmps://live-api-s.facebook.com:443/rtmp/
# Facebook Stream Key (Keep secret! Never expose to client or public repo)
FACEBOOK_STREAM_KEY=FB-Your-Live-Stream-Key-Here

# Admin Default Credentials (Used by seed script / initial setup)
ADMIN_EMAIL=admin@profootball.live
ADMIN_PASSWORD=FootballAdmin2026!Secure

# Rate Limiting & WebSocket Tuning
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
WS_HEARTBEAT_INTERVAL_MS=10000
WS_HEARTBEAT_TIMEOUT_MS=5000
