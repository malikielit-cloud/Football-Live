{
  "name": "pro-football-live-studio",
  "version": "2.0.0",
  "description": "Pro Football Live Studio v2 - Mobile Camera, Real-Time Remote Control, and Low-Cost Facebook Live Broadcast System",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "install:all": "npm install",
    "build:shared": "npm --workspace=shared run build",
    "build:server": "npm --workspace=server run build",
    "build:client": "npm --workspace=client run build",
    "build": "npm run build:shared && npm run build:server && npm run build:client",
    "start": "npm --workspace=server run start",
    "dev:server": "npm --workspace=server run dev",
    "dev:client": "npm --workspace=client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "setup:db": "npm --workspace=server run setup:db",
    "test": "npm --workspace=server run test"
  },
  "keywords": [
    "football",
    "live-streaming",
    "facebook-live",
    "websocket",
    "scoreboard",
    "remote-control",
    "sports-graphics"
  ],
  "author": "Antigravity Engineering",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
